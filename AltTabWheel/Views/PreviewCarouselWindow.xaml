<Window x:Class="AltTabWheel.Views.PreviewCarouselWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AltTabWheel Preview"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="False"
        IsHitTestVisible="False"
        Width="500" Height="760">
    <!-- 客户区分三层（z 序自下而上）：
         1. DWM 实时缩略图 —— DWM 画在客户区自绘内容"之下"，矩形由 DwmUpdateThumbnailProperties 指定；
         2. 毛玻璃 —— DwmEnableBlurBehindWindow：透明像素处显示模糊桌面（替代黑色矩形背景）；
         3. Overlay Canvas —— WPF 罩层（半透明黑 + 描边 + 圆角），逐帧与缩略图矩形同步，
            Panel.ZIndex 按距离递降：中间卡最上层，±1 下一层，依次往下。
         非 layered 宿主：DWM 缩略图在 AllowsTransparency 窗口上不渲染。 -->
    <Grid x:Name="Root">
        <Canvas x:Name="Overlay"/>
    </Grid>
</Window>
