<Window x:Class="AltTabWheel.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AltTabWheel 设置"
        Width="440" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5222226">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2E5BE6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <TextBlock Text="交互" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <CheckBox x:Name="MouseHoverBox" Content="鼠标指向选中（移动鼠标选择窗口）"/>
            <CheckBox x:Name="MergeTaskbarBox" Content="合并任务栏（同进程合并，选中后展开子轮盘）"/>

            <TextBlock Text="固定任务栏" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,4"/>
            <TextBlock Text="按进程名或 exe 路径固定应用，无窗口时选中并松开 Alt 即启动。"
                       Foreground="#99FFFFFF" FontSize="11.5" TextWrapping="Wrap"/>
            <ListBox x:Name="PinnedList" Height="130" Margin="0,8,0,0"
                     Background="#FF1B1B1E" Foreground="#E8FFFFFF"
                     BorderBrush="#33FFFFFF"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox x:Name="PinnedInput" Width="230"
                         Background="#FF1B1B1E" Foreground="#E8FFFFFF"
                         BorderBrush="#33FFFFFF" Padding="6,4"/>
                <Button Content="添加" Margin="8,0,0,0" Click="OnAddPinned"/>
                <Button Content="删除" Margin="8,0,0,0" Background="#FF55555C" Click="OnRemovePinned"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,26,0,0" HorizontalAlignment="Right">
                <Button Content="保存" Click="OnSave"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
