<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- PerMonitorV2 lives in app.manifest (required for the WPF overlay); silence the WinForms SDK nag. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <RootNamespace>AltTabWheel</RootNamespace>
    <AssemblyName>AltTabWheel</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>AltTabWheel</Product>
    <Description>Alt+Tab wheel switcher for Windows</Description>
  </PropertyGroup>

  <!-- WPF owns the UI namespace; WinForms is referenced only for NotifyIcon via explicit usings. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
